=== Structure ===

1001 = {	# character id
	name = ...
	dna = ...
	female = ...
	martial = ...
	prowess = ...
	diplomacy = ...
	intrigue = ...
	stewardship = ...
	learning = ...
	trait = ...
	father = ...
	mother = ...
	disallow_random_traits = ...

	### brief: obscured (bool)
	# set to yes if the character should not be clickable.
	# Add a <character_id>_obscured_desc loc entry to optionally generate a flavor description
	# that would show up in the character tooltip instead.
	#
	obscured = no

	# For mod compatability
	# Allows this history character definition to override & add to an existing history character id from the unmodded game/another mod, while being in a differently named file to not override the entire file
	# Default is 0, all unmodded history character definitions have default
	# The definition with the largest override priority value overrides other definitions
	# It is an error for character definitions sharing identical ids to not have different override priority
	# NOTE: Only the base attributes (i.e. everything listed higher up in this file) of the character and the date of birth are overridden, other things combine additively.
	history_override_priority = integer

	# The Rite practiced by the Character.
	rite = ...
	
	# The Faith practiced by the Character. The mainline Rite for that Faith will be chosen as Rite.
	# also supports religion = <faith> as compatibility option
	#
	faith = ...

	culture = ...
	dynasty = ...
	dynasty_house = ...
	give_nickname = ...
	sexuality = ...
	health = ...
	fertility = ...
	set_house = ...
	set_culture = ...
	set_character_faith_no_effect = ...
	add_spouse/add_matrilineal_spouse/add_same_sex_spouse = ...
	
	portrait_override = {	# Will override the character's appearance
		portrait_modifier_overrides={
			modifier_category_1 = modifier_1 # E.g. clothes=western_low_nobles
			modifier_category_1 = modifier_2
			...
		}
		hair={ R G B }	# hair color, e.g. hair={ 0.592 0.314 0.176 }
	}

	1050.01.01 = {
		birth = yes
	}
	# All date entries must be between birth and death, except ones that only contain effect_even_if_dead, those may also happen after death.
	1099.01.01 = {
		effect = { # Executes if the character is alive during the selected start date.
			...
		}
		effect_even_if_dead = { # Executes regardless of the character's life status.
			...
		}
	}
	1150.01.01 = {
		death = {
			death_reason = death_duel
		}
	}
}

1002 = ....
