Geographical regions

new_region_key = {

	# Notice it takes original titles dejure land
	# Dejure drift during the game has no effect on geographical regions
	#
	hegemonies = { }		# takes de-jure hegemony title names declared in landed_titles.txts 
	empires = { }			# takes de-jure empire title names declared in landed_titles.txts 
	kingdoms = { }			# takes de-jure kingdom title names declared in landed_titles.txt
	duchies = { }			# takes de-jure duchy title names declared in landed_titles.txt
	counties = { }			# takes de-jure county title names declared in landed_titles.txt

	provinces = { }			# takes province id numbers declared in /history/provinces

	# a region can also include other regions, however the subregions needs to be declared before the parent region
	# E.g. If the region world_europe contains the region world_europe_west then world_europe_west needs to be declared
	# as a region before (i.e. higher up in this file) world_europe.
	regions = { }

	# (bool) is this region used to determine type of graphics used on the map
	# Entire map must be covered by non-overlapping graphical regions
	#
	graphical = no

	# (RGB color) Color used in visual regions map mode
	#
	color = { 255 0 128 }

	# (bool) Shall this region generate development growth modifiers:
	# key + _development_growth
	# key + _development_growth_factor
	generate_modifiers = no
}
