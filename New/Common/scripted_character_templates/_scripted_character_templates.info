### Brief: key ( database key )
# Reusable character setup. The template body is parsed by the same code as the create_character effect
# (SScriptedCharacterData), so it accepts every create_character parameter except location and save_scope_as.
#
# Where templates are used:
#	create_character = { template = <key> ... } - parameters in the effect override those in the template
#	template = <key> inside another template - nesting (a template can't reference itself)
#	generated_character_template = <key> in common/governments - used when code generates a ruler for a county
#	GENERATED_POOL_CHARACTER_TEMPLATES in defines - used to repopulate the pool and to generate guests
#	herder_character - required by code. Used to create herders for titles (e.g. when nomads migrate)
#
# Supported scopes (for all script values, triggers and scope targets below, unless stated otherwise):
#	create_character: same as where create_character is used
#	generated_character_template: root = the county title
#	GENERATED_POOL_CHARACTER_TEMPLATES: root = the ruler the pool character is generated for
#	herder_character: root = the county title, scope:actor = the character (nomad) giving up the title
#
key = {
	### Brief: template ( scripted character template key )
	# Base template. It's applied first, then any parameters set here override it.
	# An error is logged if it doesn't exist or points to itself.
	#
	template = other_template_key

	### Brief: name ( optional localization key )
	# First name.
	# Default: the base template's name, otherwise a random name
	#
	name = Bernard_of_Clairvaux

	### Brief: age ( script value )
	# Age in years.
	# Default: random age from the FEMALE/MALE_RANDOM_AGE_BASE and _SPAN defines
	#
	age = { 18 50 }

	### Brief: gender ( male / female / character scope )
	# male or female, or a character: the new character gets that character's gender.
	#
	gender = male

	### Brief: opposite_gender ( character scope )
	# The new character gets the opposite gender of this character.
	#
	opposite_gender = scope:someone

	### Brief: gender_female_chance ( script value )
	# Chance (0-100) that the new character is female. Ignored if gender = <character> or opposite_gender is set.
	#
	# If no gender data is set here or in a base template: create_character logs an error,
	# and pool generation picks 50/50.
	#
	gender_female_chance = 50

	### Brief: trait ( trait key, repeatable )
	# Always adds this trait.
	#
	trait = brave

	### Brief: random_traits_list ( block, repeatable )
	# Picks count traits, weighted at random, from the entries whose trigger is met. A trait can't be picked twice.
	# Several random_traits_list blocks can be defined.
	#
	random_traits_list = {
		### Brief: count ( script value )
		# Default: 1
		count = { 1 2 }

		<trait_key> = {
			### Brief: trigger ( trigger )
			# Default: empty (always true)
			trigger = { <triggers> }

			### Brief: weight ( mtth )
			# Default: base = 1
			weight = { base = 1 }
		}
	}

	### Brief: random_traits ( script value, bool )
	# Should random traits (personality, education etc.) be generated, and congenital traits inherited from parents?
	# Default: yes
	#
	random_traits = no

	### Brief: health ( script value )
	# Base health. Negative values are ignored.
	# Default: random between the RANDOM_CHARACTER_MIN_HEALTH and RANDOM_CHARACTER_MAX_HEALTH defines
	#
	health = 5

	### Brief: fertility ( script value )
	# Fertility. Negative values are ignored.
	# Default: random between the RANDOM_CHARACTER_MIN_FERTILITY and RANDOM_CHARACTER_MAX_FERTILITY defines
	#
	fertility = 0.5

	### Brief: diplomacy/martial/stewardship/intrigue/learning/prowess ( script value )
	# Base skill. Negative values are ignored.
	# Default: random
	#
	martial = { 8 12 }

	### Brief: mother ( character scope )
	# Must be female, otherwise an error is logged.
	#
	mother = scope:mother

	### Brief: father ( character scope )
	# Must be male, otherwise an error is logged.
	#
	father = scope:father

	### Brief: real_father ( character scope )
	# Biological father, if it's not the same as father. Must be male, otherwise an error is logged.
	#
	real_father = scope:real_father

	### Brief: employer ( character scope )
	# Court the new character joins.
	# Default: the father if he is a ruler, otherwise the mother if she is a ruler
	# For create_character, either employer (here or in the template) or the effect's location must be set, but not both.
	#
	employer = root

	### Brief: template_character ( character scope )
	# Character that culture, faith, rite and dynasty house are copied from, if not set directly.
	# Also used by ethnicity = template_character.
	#
	template_character = scope:someone

	### Brief: culture ( culture key / culture scope )
	# Culture of the new character.
	# Default, in order: template_character, the base template, father, mother, employer
	#
	culture = root.culture

	### Brief: random_culture ( block )
	# Picks a random culture, weighted, from the entries whose trigger is met.
	# Each key is a culture key or culture scope. If no entry is valid, an error is logged.
	#
	random_culture = {
		culture:norse = {
			trigger = { <triggers> }	# Default: always true
			weight = { base = 1 }		# mtth. Default: base = 1
		}
	}

	### Brief: random_culture_in_group ( culture key / culture scope )
	# Picks a random culture that has the same heritage as this culture.
	#
	random_culture_in_group = root.culture

	### Brief: faith ( faith key / faith scope )
	# Faith of the new character. The character gets its main rite.
	# Default, in order: template_character's rite, the base template, father's rite, mother's rite, employer's rite
	#
	faith = root.faith

	### Brief: random_faith ( block )
	# Picks a random faith, weighted, from the entries whose trigger is met.
	# Each key is a faith key or faith scope. If no entry is valid, an error is logged.
	#
	random_faith = {
		catholic = {
			trigger = { <triggers> }	# Default: always true
			weight = { base = 1 }		# mtth. Default: base = 1
		}
	}

	### Brief: random_faith_in_religion ( faith key / faith scope )
	# Picks a random faith from the same religion as this faith. The character gets its main rite.
	#
	random_faith_in_religion = root.faith

	### Brief: rite ( rite scope )
	# Overrides the rite derived from faith or the defaults above, if it's valid.
	#
	rite = root.rite

	### Brief: dynasty_house ( dynasty house key / dynasty house scope )
	# House of the new character. Takes priority over dynasty = generate/inherit.
	#
	dynasty_house = house:house_borjigin

	### Brief: dynasty ( enum )
	# What to do if dynasty_house isn't set:
	#	generate - create a new dynasty from the character's culture (only at the outermost level, never inside a base template)
	#	inherit - take the house of template_character, otherwise of the father (or the mother, if there is no father or the marriage is matrilineal), otherwise of the employer
	#	none - lowborn
	#	default - generate, unless a base template set none
	# Default: default
	#
	dynasty = none

	### Brief: ethnicity ( enum or ethnicity key )
	# How to pick the ethnicity:
	#	default - random parent's ethnicity; if there are no parents, a random ethnicity from the culture
	#	parents - random parent's ethnicity (real_father is used instead of father if set)
	#	mother - the mother's ethnicity
	#	father - the father's ethnicity (real_father if set)
	#	culture - random ethnicity from the culture
	#	template_character - template_character's ethnicity
	#	<ethnicity key> - this ethnicity
	# Default: default
	#
	ethnicity = culture

	### Brief: ethnicities ( block )
	# Picks a random ethnicity, weighted, from the entries whose trigger is met. Same as ethnicity = list.
	#
	ethnicities = {
		<ethnicity_key> = {
			trigger = { <triggers> }	# Default: always true
			weight = { base = 1 }		# mtth. Default: base = 1
		}
	}

	### Brief: after_creation ( effect )
	# Runs after the character is created. Base template effects run first.
	#
	# Supported scopes:
	#	this ( character ) - the new character
	#	prev - the scope the character was created in
	#	root and saved scopes: same as the calling context
	#
	after_creation = {
		<effects>
	}
}

#########################
# == Notes ==
#########################
# When a base template is used, its values are applied first and anything set in the outer template or create_character replaces them.
# The "random in group" behavior is a single flag, set by whichever culture / random_culture_in_group line is read last
# (faith / random_faith_in_religion for faiths). It then applies to the chosen culture / faith, including one picked from random_culture / random_faith.
