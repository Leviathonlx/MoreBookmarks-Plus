### Brief: province_terrain
# Assigns terrain types ( common/terrain_types ) and winter properties to map provinces.
# This is not a regular keyed database: every .txt file in the folder is read in order, and each file can
# contain any mix of the statements below. Unknown top-level keys log an error and are skipped.
# By convention 00_province_terrain.txt holds the terrain assignments and 01_province_properties.txt the winter properties.
#

#########################
# == Default terrains ==
#########################

### Brief: default_land ( terrain type key )
# Terrain used for land provinces that have no terrain assigned.
#
default_land = plains

### Brief: default_sea ( terrain type key )
# Terrain used for non-coastal sea provinces that have no terrain assigned.
#
default_sea = sea

### Brief: default_coastal_sea ( terrain type key )
# Terrain used for coastal sea provinces that have no terrain assigned.
#
default_coastal_sea = coastal_sea

#########################
# == Terrain assignment ==
#########################

### Brief: <province id> ( terrain type key )
# Assigns a terrain type to the province with this id.
# Error logged if the terrain type doesn't exist.
# Impassable provinces are never given a terrain.
#
1 = mountains

#########################
# == Province properties ==
#########################

### Brief: <province id> ( block )
# Sets winter properties for the province with this id.
# Error logged ( and the block skipped ) if the id is outside the maximum number of provinces.
# Unknown keys inside the block are ignored.
#
1 = {
	### Brief: winter_severity_bias ( optional fixed point )
	# How strongly winter affects this province. Provinces with a bias of 0 or less are not affected by winter.
	# Default: WINTER_SEVERITY_DEFAULT_BIAS ( define NProvince )
	#
	winter_severity_bias = 0.5

	### Brief: fixed_winter_override ( optional fixed point )
	# If above 0, the province always has this winter severity instead of a simulated one.
	# Default: 0 ( not used )
	#
	fixed_winter_override = 0.5

	### Brief: mild_winter_factor_override ( optional fixed point )
	# If above 0, used instead of WINTER_EFFECTS_FACTOR_MILD when the province has no or mild winter.
	# Default: 0 ( not used )
	#
	mild_winter_factor_override = 0.1

	### Brief: normal_winter_factor_override ( optional fixed point )
	# If above 0, used instead of WINTER_EFFECTS_FACTOR_NORMAL when the province has normal winter.
	# Default: 0 ( not used )
	#
	normal_winter_factor_override = 0.1

	### Brief: harsh_winter_factor_override ( optional fixed point )
	# If above 0, used instead of WINTER_EFFECTS_FACTOR_HARSH when the province has harsh winter.
	# Default: 0 ( not used )
	#
	harsh_winter_factor_override = 0.1
}
