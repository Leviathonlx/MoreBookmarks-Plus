### Brief: key ( database key )
# Scripted dynasty template. The key can be a number or a string.
# History characters refer to it with dynasty = <key>, and script with dynasty:<key>.
# When a dynasty is created from the template, its founding house copies the name, prefix and motto from here.
# Houses for this dynasty are defined in common/dynasty_houses.
#
# Default coat of arms: the coat of arms in common/coat_of_arms with the same name as the key, if there is one.
#
key = {
	### Brief: name ( localization key )
	# Name of the dynasty.
	# Required. If missing or it localizes to an empty string, an error is logged and "Fletcher" is used instead.
	#
	name = "dynn_Name"

	### Brief: prefix ( optional localization key )
	# Name prefix (e.g. "dynnp_de"). Put in front of the localized name.
	# Default: none
	#
	prefix = "dynnp_de"

	### Brief: culture ( culture key )
	# Source culture of the dynasty. Should be set: an error is logged if it's missing or invalid when the dynasty is created.
	# Its primary name list decides whether the dynasty name may be used in realm names on the map.
	# Houses of this dynasty also use this culture.
	#
	culture = "french"

	### Brief: motto ( optional localization key )
	# Motto of the dynasty. Also given to the founding house.
	# Default: none
	#
	motto = dynn_Name_motto

	### Brief: forced_coa_religiongroup ( optional string )
	# Read and stored on the dynasty (and its founding house) and saved, but not currently used by any game logic.
	# Default: none
	#
	forced_coa_religiongroup = "muslim"

	### Brief: color ( optional color )
	# Read, but not currently used by any game logic.
	#
	color = { 1 1 1 }
}
