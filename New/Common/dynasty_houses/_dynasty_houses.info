### Brief: key ( database key )
# Scripted dynasty house template.
# History characters refer to it with dynasty_house = <key>, and script with house:<key>.
# The house's culture is taken from its dynasty's culture.
#
# Default coat of arms: the coat of arms in common/coat_of_arms with the same name as the key, if there is one.
#
key = {
	### Brief: dynasty ( dynasty key )
	# The dynasty (from common/dynasties) this house belongs to.
	# Required. An error is logged if it's missing or not a valid dynasty.
	#
	dynasty = 25061

	### Brief: name ( localization key )
	# Name of the house.
	# Required. If missing, an error is logged and "Fletcher" is used instead.
	#
	name = "dynn_Name"

	### Brief: prefix ( optional localization key )
	# Name prefix (e.g. "dynnp_von"). Put in front of the localized name.
	# Default: none
	#
	prefix = "dynnp_von"

	### Brief: motto ( optional localization key )
	# Motto of the house.
	# Default: none
	#
	motto = dynn_Name_motto

	### Brief: forced_coa_religiongroup ( optional string )
	# Read and stored on the house and saved, but not currently used by any game logic.
	# Default: none
	#
	forced_coa_religiongroup = "muslim"

	### Brief: color ( optional color )
	# Read, but not currently used by any game logic.
	#
	color = { 1 1 1 }
}
