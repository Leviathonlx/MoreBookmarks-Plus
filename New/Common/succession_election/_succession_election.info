== Structure ==

feudal_elective = {

	# Characters that can be elected
	# In addition to the scripted limitations, the gender and faith laws are taken into account. Also the current title holder can never be a candidate.
	candidates = {

		# A set of candidates. Can list multiple sets. By default if a character matches any set, they will be a valid candidate
		character_sets = {
			# If 'candidate_policy' is not 'include_all_candidates', then each set pick only one best candidate, according to candidate score.
			# In this case order of sets matter. If person was the best if some set, they will be excluded from the following sets
			# use unique keys, they will be used to support tracing the candidates back to the set they were generated from.
			#
			key = {
				type = holder_direct_vassals/...	# see Candidate Set Types below

				### Brief: priority_value ( optional scripted value Fixed Point )
				# Does candidates from this set require unique scoring compared to other sets?
				# Note: Score calculated here will be added in addition to sum of the general priority_value applied for every set
				#
				# Supported scopes:
				#	root ( Character )
				#		Character evaluated as candidate
				#
				priority_value = {}

				# trigger that must be true for the character in the set. scopes:
				#	root = candidate character
				#	scope:title = the title under election
				#	scope:holder = current title holder
				# default: always = yes
				#
				limit = {}
			}
		}

		# Same "limit" trigger defined inside the "sets" objects, but checked for all character sets
		limit = {}

		# Optional value to calculate a character's priority; only relevant when there is a 'max' for electors;
		# scope: see "limit"
		#
		priority = {}		# uses MTTH syntax
		priority_value = {}	# uses scripted value syntax

		### brief: candidate_policy ( enum )
		# 'include_all_candidates' - all candidates from every candidate set are included
		# 'only_best_candidate' - every set provides only the best candidate, according to priority
		#	(each candidate can appear only once, and if one is best in more than one set you will end up with less candidates than sets)
		# 'one_candidate_per_set' - every set is evaluated in sequence and provides the best candidate that wasn't already selected in previous sets
		#
		# default is include_all_candidates
		#
		candidate_policy = include_all_candidates
	}

	# Characters that can vote in the election
	# Note that only rulers can be electors.
	electors = {
		# all elements from "candidates" are valid

		max = 10			# optional maximum number of electors, <0 for no limitation; default: -1
	}

	# Optional value to calculate the score an elector should add with their vote;
	# scope: root = elector, scope:title = the title under election, scope:holder = current title holder;
	#
	elector_vote_strength = {}			# uses MTTH syntax
	elector_vote_strength_value = {}	# uses scripted value syntax

	# Value to calculate the AI voting behavior. AI electors will choose the candidate with the highest score.
	# Scope: root = elector, scope:candidate = the considered candidate, scope:title = the title under election,
	# scope:holder = current title holder, scope:holder_candidate = the title holder's candidate
	#
	candidate_score = {}		# uses MTTH syntax
	candidate_score_value = {}	# uses scripted value syntax
}

== Candidate Set Types ==

- title_claimants				# any claimants of the title
- title_dejure_vassals			# direct & indirect vassals in the dejure hierarchy under the title, lowest level: minimum playable tier (county)
- holder						# current holder of the title
- holder_direct_vassals			# direct vassals of the current holder of the title
- holder_spouses
- holder_close_family
- holder_close_or_extended_family
- holder_dynasty
- holder_council_members
- holder_tributaries
- same_faith_clerical_electors	# holders of elector titles for the same faith as the holder of the title
