### Brief: key ( database key )
# Name of 'game_concept'
# Game concepts are the linkable, tooltipped terms used in localization and the encyclopedia.
# Localization is derived from the key:
#	Name:			game_concept_<key>
#	Description:	game_concept_<key>_desc		( error logged if missing )
#
key = {
	### Brief: alias ( optional list of keys )
	# Additional keys that refer to this concept. Each alias becomes its own concept entry that shares the
	# original's parent, texture, frame and description (game_concept_<original_key>_desc).
	# Each alias still needs its own name loc key: game_concept_<alias>
	# Aliases are not listed in the encyclopedia.
	# Error logged (and the alias skipped) if an alias collides with an existing concept or alias key.
	#
	alias = { alias_1 alias_2 }

	### Brief: parent ( optional game concept key )
	# Parent concept, shown in the concept tooltip via the CONCEPT_TEXT loc key.
	# Error logged if the key doesn't exist.
	# Default: none
	#
	parent = other_concept

	### Brief: texture ( optional texture path / piety / legitimacy )
	# Icon of the concept, full path to the texture file.
	# Special values:
	#	piety		Uses the local player's faith piety icon ( piety icon group of the faith )
	#	legitimacy	Uses the local player's legitimacy type icon ( falls back to the default legitimacy type )
	# Setting this ( any value ) makes the concept have an icon.
	# Default: no icon
	#
	texture = "gfx/interface/icons/icon_vassal.dds"

	### Brief: frame ( optional int )
	# Frame of the texture to use, for textures that are sprite sheets.
	# Default: 1
	#
	frame = 1

	### Brief: framesize ( optional int pair )
	# Size of one frame in the texture, used together with frame.
	#
	framesize = { 40 40 }

	### Brief: shown_in_encyclopedia ( optional bool )
	# Should this concept be listed in the encyclopedia?
	# Default: yes
	#
	shown_in_encyclopedia = yes

	### Brief: requires_dlc_flag ( optional dlc feature flag )
	# If set, the concept is only listed in the encyclopedia when the dlc feature is available.
	# Doesn't affect use of the concept in localization.
	# Default: none
	#
	requires_dlc_flag = some_dlc
}

#########################
# == Localization ==
#########################
# Every concept key ( including aliases ) is usable in localization:
#	[key|E]								Concept with its name ( game_concept_<key> ), with tooltip
#	[Concept( 'key', 'Custom Text' )|E]	Concept with custom text
#	[ConceptByKey( 'key' )|E]			Same as [key|E]
