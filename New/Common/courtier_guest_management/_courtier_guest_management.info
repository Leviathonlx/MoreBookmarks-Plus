### Brief: key ( database key )
# Rules for when courtiers and guests leave a court, and which pool characters arrive as guests.
# Only two keys are used by code, both required:
#	courtier_management - courtiers (characters employed at a court)
#	guest_management - guests (characters staying at a court without an employer) and pool characters that may arrive as guests
# Any other key is loaded but never used.
#
key = {
	### Brief: can_leave ( trigger )
	# Does the character want to leave the court?
	# Checked once a year for each courtier/guest of every ruler. While it stays true, monthly_leave_chance_x10 is rolled every month.
	# If it becomes false before the character has left, they stop wanting to leave.
	# Not checked for hostages, or for guests who can't consider leaving yet.
	# Default: empty (always true)
	#
	# Supported scopes:
	#	courtier_management:
	#		root, scope:courtier ( character ) - the courtier
	#		scope:liege ( character ) - their employer
	#	guest_management:
	#		root, scope:guest ( character ) - the guest
	#		scope:host ( character ) - their host
	#
	can_leave = {
		<triggers>
	}

	### Brief: monthly_leave_chance_x10 ( mtth )
	# Monthly chance, in per mille (10 x the chance in %), that the character commits to leaving while can_leave is true.
	# Rolled against a random number in [0, 1000).
	# Uses mean-time-to-happen syntax (base, modifier, opinion_modifier, ...); the resulting factor is the chance.
	# Default: base = 1
	#
	# Supported scopes: same as can_leave
	#
	monthly_leave_chance_x10 = {
		base = 20
		modifier = { ... }
	}

	### Brief: guest_can_arrive ( trigger )
	# Can this pool character arrive as a guest at the host's court?
	# Checked monthly for pool characters in and around the capital province of each landed ruler with free guest slots.
	# Only used in guest_management; setting it in courtier_management logs an error.
	# Default: empty (always true)
	#
	# Supported scopes:
	#	root, scope:guest ( character ) - the potential guest
	#	scope:host ( character ) - the potential host
	#
	guest_can_arrive = {
		<triggers>
	}

	### Brief: guest_score ( mtth )
	# Score used to rank the pool characters that pass guest_can_arrive. The host picks at random among the highest-scoring candidates.
	# Uses mean-time-to-happen syntax; the resulting factor is the score.
	# Only used in guest_management; setting it in courtier_management logs an error.
	# Default: base = 1
	#
	# Supported scopes: same as guest_can_arrive
	#
	guest_score = {
		base = 100
		modifier = { ... }
	}

	### Brief: guest_description ( block )
	# Text shown for a guest to say what they could be useful for.
	# Of the entries whose limit is met, the one with the highest weight is shown. On a tie, the first one wins.
	# If no entry is valid, nothing is shown.
	# Only used in guest_management; in courtier_management it's ignored.
	#
	# Supported scopes (for limit, weight and desc):
	#	root, scope:guest ( character ) - the guest
	#	scope:host ( character ) - their host
	#
	guest_description = {
		### Brief: description ( block, repeatable )
		description = {
			### Brief: limit ( trigger )
			# Default: empty (always true)
			limit = { <triggers> }

			### Brief: weight ( mtth )
			# Default: base = 1
			weight = { base = 1 }

			### Brief: desc ( dynamic description )
			desc = { ... }
		}
		description = { ... }
	}
}

