### Brief: key ( database key )
# Name of 'connection_arrow'
# An animated arrow drawn on the map through a list of provinces. Used for the Silk Road routes;
# the arrows are only updated while the Silk Road view is open.
#
key = {
	### Brief: provinces ( list of province ids )
	# Provinces the arrow passes through, in order. The first province is the start point and the last is the end point.
	# The provinces do not need to be adjacent; a smoothed curve is drawn through them.
	# The list must contain more than 2 provinces, otherwise no arrow is drawn.
	# Listing the same province more than once logs an error.
	#
	provinces = {
		1 2 3
	}

	### Brief: arrow_type ( string )
	# Name of the arrowType (defined in gfx .asset files, e.g. gfx/models/mapitems/arrows.asset) used to draw the arrow.
	# On the flat map the arrowType named <arrow_type>FlatMap is used instead; both must exist.
	#
	arrow_type = "silkRoadArrow"

	### Brief: is_primary ( optional bool )
	# If yes, the arrow is used to show innovations travelling along the Silk Road.
	# The first province of a primary arrow must be the center province of a Silk Road situation sub-region;
	# the innovation of that sub-region is shown travelling along the arrow.
	# Default: no
	#
	is_primary = yes/no
}
