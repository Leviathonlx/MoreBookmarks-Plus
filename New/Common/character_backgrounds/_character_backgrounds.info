### Brief: key ( database key )
# Name of 'character_background'
# A set of traits given to a generated character, which an existing character must also have to match the background.
# Referenced by key from 'background' in pool character selectors (see ../pool_character_selectors/_pool_character_selectors.info)
# and from 'background' in random character creation configs.
# The background 'commander' is referenced by code and must exist: it is used when generating and selecting
# commanders for courts and mercenary companies.
#
key = {
	### Brief: trait ( trait or trait group key, repeatable )
	# A trait, or a trait group, the character gets / must have. Can be given multiple times.
	# The key is first looked up as a trait; if no such trait exists, it is looked up as a trait group
	# (the 'group' field of traits). An unknown key or an empty trait group logs an error.
	#
	# When a character is created with this background:
	#	trait: added if the character can get it, otherwise an error is logged
	#	trait group: one trait the character can get is picked from the group by weight;
	#		if none can be picked, an error is logged
	#
	# When checking whether an existing character matches the background, the character must have every
	# listed trait, and at least one trait from every listed trait group. Invalid entries always match.
	#
	trait = trait_key
	trait = trait_group_key
}
