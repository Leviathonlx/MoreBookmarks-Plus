# Name of group, localization is selected by: "decision_group_type_" + <key>
key = {
	sort_order = integer			# The order decision groups show up in the decision view, higher number is sorted first, tie breaking is on definition order. Default = 0
	gui_tags = { tag_1 tag_2 ... }	# List of gui tags, used to set size etc in gui views
	important_decision_group = yes/no	# Decisions in this group are important by default (player can override; important decisions spawn an Action when they can be taken). Default = no
}
